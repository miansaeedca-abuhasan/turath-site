<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:layoutDirection="locale">
    <ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/wbg_dark" android:scaleType="fitXY" />
    <ImageView android:id="@+id/wm" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/logo" android:scaleType="centerInside" android:padding="6dp" android:alpha="0.13" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="10dp" android:gravity="center_vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_marginEnd="5dp" android:src="@drawable/logo" android:scaleType="fitCenter" />
            <TextView android:id="@+id/city" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#E0B54A" android:textSize="12sp" android:maxLines="1" android:text="Makkah" />
            <TextView android:id="@+id/date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" android:textColor="#FFFFFF" android:textSize="15sp" android:maxLines="1"  android:text="" />
            <TextView android:id="@+id/gear" android:layout_width="26dp" android:layout_height="20dp" android:gravity="center" android:textColor="#AAFFFFFF" android:textSize="14sp" android:text="⚙" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:id="@+id/prayer" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="30sp" android:textStyle="bold" android:maxLines="1" android:text="Asr" />
            <Chronometer android:id="@+id/count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="28sp" />
        </LinearLayout>
        <ImageView android:id="@+id/line" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="4dp" android:src="@drawable/wline" android:scaleType="fitXY" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:id="@+id/c0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingTop="4dp" android:paddingBottom="4dp">
                <TextView android:id="@+id/n0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#CCFFFFFF" android:textSize="12sp" android:maxLines="1"  android:text="—" />
                <TextView android:id="@+id/w0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="14sp" android:maxLines="1"  android:text="0:00" />
            </LinearLayout>
            <FrameLayout android:id="@+id/c1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                <ViewFlipper android:id="@+id/blink1" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="2dp" android:autoStart="true" android:flipInterval="600" android:visibility="gone">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/wb_red" android:scaleType="fitXY" />
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/wcal_none" android:scaleType="fitXY" />
                </ViewFlipper>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:paddingTop="4dp" android:paddingBottom="4dp">
                <TextView android:id="@+id/n1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#CCFFFFFF" android:textSize="12sp" android:maxLines="1"  android:text="—" />
                <TextView android:id="@+id/w1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="14sp" android:maxLines="1"  android:text="0:00" />
            </LinearLayout>
            </FrameLayout>
            <LinearLayout android:id="@+id/c2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingTop="4dp" android:paddingBottom="4dp">
                <TextView android:id="@+id/n2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#CCFFFFFF" android:textSize="12sp" android:maxLines="1"  android:text="—" />
                <TextView android:id="@+id/w2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="14sp" android:maxLines="1"  android:text="0:00" />
            </LinearLayout>
            <LinearLayout android:id="@+id/c3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingTop="4dp" android:paddingBottom="4dp">
                <TextView android:id="@+id/n3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#CCFFFFFF" android:textSize="12sp" android:maxLines="1"  android:text="—" />
                <TextView android:id="@+id/w3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="14sp" android:maxLines="1"  android:text="0:00" />
            </LinearLayout>
            <LinearLayout android:id="@+id/c4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingTop="4dp" android:paddingBottom="4dp">
                <TextView android:id="@+id/n4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#CCFFFFFF" android:textSize="12sp" android:maxLines="1"  android:text="—" />
                <TextView android:id="@+id/w4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="14sp" android:maxLines="1"  android:text="0:00" />
            </LinearLayout>
            <LinearLayout android:id="@+id/c5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingTop="4dp" android:paddingBottom="4dp">
                <TextView android:id="@+id/n5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#CCFFFFFF" android:textSize="12sp" android:maxLines="1"  android:text="—" />
                <TextView android:id="@+id/w5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="14sp" android:maxLines="1"  android:text="0:00" />
            </LinearLayout>
        </LinearLayout>
        <ViewFlipper android:id="@+id/tk" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:autoStart="true" android:flipInterval="13000" android:inAnimation="@anim/tk_crawl" />
            <ViewFlipper android:id="@+id/tbl" android:layout_width="match_parent" android:layout_height="wrap_content" android:autoStart="true" android:flipInterval="600" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
                    <TextView android:id="@+id/tb0" android:layout_width="0dp" android:layout_weight="1" android:gravity="end" android:layout_height="wrap_content" android:singleLine="true" android:textColor="#FF3B30" android:textSize="12sp" android:textStyle="bold" android:text="" />
                    <Chronometer android:id="@+id/tc0" android:layout_width="wrap_content" android:singleLine="true" android:minWidth="64dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textColor="#FF3B30" android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
                    <TextView android:id="@+id/tb1" android:layout_width="0dp" android:layout_weight="1" android:gravity="end" android:layout_height="wrap_content" android:singleLine="true" android:textColor="#00FF3B30" android:textSize="12sp" android:textStyle="bold" android:text="" />
                    <Chronometer android:id="@+id/tc1" android:layout_width="wrap_content" android:singleLine="true" android:minWidth="64dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textColor="#00FF3B30" android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>
            </ViewFlipper>
        <TextView android:id="@+id/date2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#AAFFFFFF" android:textSize="11sp" android:maxLines="1" android:layout_gravity="center_horizontal" android:text="" />
    </LinearLayout>
</FrameLayout>
